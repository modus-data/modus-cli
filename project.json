{
  "name": "modus-cli",
  "sourceRoot": "distribution/clients/cli/modus-cli/src",
  "projectType": "application",
  "tags": ["scope:cli", "type:app", "lang:typescript"],
  "implicitDependencies": ["modus-sdk-typescript"],
  "targets": {
    "typecheck": {
      "dependsOn": [{ "projects": ["modus-sdk-typescript"], "target": "build" }]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["modus-sdk-typescript"], "target": "build" }],
      "options": {
        "command": "pnpm --filter @getmodus/cli run build",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/oclif.manifest.json"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "default",
        "^production",
        "vitestHarness",
        "{workspaceRoot}/apps/services/*/openapi/v1.json",
        "{workspaceRoot}/distribution/clients/sdk-surface.json"
      ],
      "options": {
        "command": "vitest run --root distribution/clients/cli/modus-cli",
        "cwd": "{workspaceRoot}"
      }
    },
    "cli-docs:check": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "pnpm run cli-docs:sync && pnpm run cli-docs:nav && pnpm run cli-docs:check",
        "cwd": "{workspaceRoot}"
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/tools/cli-docs/**",
        "{workspaceRoot}/distribution/docs/cli/**",
        "{workspaceRoot}/distribution/docs/cli-nav.json"
      ]
    },
    "lint": {
      "dependsOn": ["typecheck"]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @getmodus/cli run clean",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    },
    "test-staging-smoke": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bash distribution/clients/cli/modus-cli/scripts/staging-context-files-smoke.sh",
        "cwd": "{workspaceRoot}"
      },
      "cache": false
    }
  }
}
